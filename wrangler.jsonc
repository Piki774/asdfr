{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "asdfr",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "178dc6e6-7b9f-4b28-8337-9dab474e381c","database_name": "were" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "1c6af332138e4f628c05a06ade65f90b" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
